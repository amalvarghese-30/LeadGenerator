# Candid Digital — Backend Environment Variables
# Copy this file to .env and fill in your values.

# App
APP_NAME=Candid Digital
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development

# MongoDB (legacy, still in use)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=leadintel
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# MySQL / SQLAlchemy
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=candiddigital
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/candiddigital
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=3600

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# NVIDIA / NIM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_ENABLED=False

# SearXNG
SEARXNG_BASE_URL=
SEARXNG_TIMEOUT=10

# Crawler
CRAWLER_MAX_CONCURRENT=5
CRAWLER_REQUEST_TIMEOUT=30
CRAWLER_USER_AGENT=CandidDigitalBot/1.0 (+https://candiddigital.in/)
CRAWLER_DELAY_SECONDS=1.0
CRAWLER_MAX_RETRIES=3
CRAWLER_MAX_PAGES_PER_JOB=50
CRAWLER_SAFETY_MAX_PAGES=500
CRAWLER_CONCURRENCY=3
CRAWLER_THREAD_WORKERS=8
CRAWLER_BROWSER_CONCURRENCY=2
PLAYWRIGHT_HEADLESS=True

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Scheduler
RECRAWL_INTERVAL_DAYS=7
RSS_CHECK_INTERVAL_HOURS=6
FAILED_JOB_RETRY_INTERVAL_HOURS=1

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
