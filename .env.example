# Application
APP_NAME=Candid Digital
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# MySQL / SQLAlchemy
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=candiddigital
DATABASE_URL=mysql+aiomysql://root:your_mysql_password@localhost:3306/candiddigital
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=3600

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# MongoDB (Legacy, kept for zero-downtime transition)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=candiddigital
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# Security & Authentication
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-secret-key-32b
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Integration (Optional - NVIDIA Nemotron / NIM)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_ENABLED=False

# Self-Hosted Search Backend (Optional)
SEARXNG_BASE_URL=
SEARXNG_TIMEOUT=10

# Crawler Config
CRAWLER_MAX_CONCURRENT=5
CRAWLER_REQUEST_TIMEOUT=30
CRAWLER_USER_AGENT=CandidDigitalBot/1.0 (+https://candiddigital.in/)
CRAWLER_DELAY_SECONDS=1.0
CRAWLER_MAX_RETRIES=3
CRAWLER_CONCURRENCY=3
CRAWLER_THREAD_WORKERS=8
CRAWLER_BROWSER_CONCURRENCY=2
PLAYWRIGHT_HEADLESS=True

# Rate Limiting & Admin
DEFAULT_RATE_LIMIT=100/minute
SEARCH_RATE_LIMIT=20/minute
DEFAULT_ADMIN_EMAIL=admin@candiddigital.in
DEFAULT_ADMIN_PASSWORD=Admin@123456
