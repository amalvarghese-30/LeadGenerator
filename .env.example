# Application
APP_NAME=LeadIntel CRM
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=leadintel
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# Security & Authentication
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-secret-key-32b
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Integration (Optional - NVIDIA Nemotron / NIM)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_ENABLED=False

# Self-Hosted Search Backend (Optional)
SEARXNG_BASE_URL=
SEARXNG_TIMEOUT=10

# Crawler Config
CRAWLER_MAX_CONCURRENT=5
CRAWLER_REQUEST_TIMEOUT=30
CRAWLER_USER_AGENT=LeadIntelBot/1.0 (+https://leadintel.io/bot)
CRAWLER_DELAY_SECONDS=1.0
CRAWLER_MAX_RETRIES=3
PLAYWRIGHT_HEADLESS=True

# Rate Limiting & Admin
DEFAULT_RATE_LIMIT=100/minute
SEARCH_RATE_LIMIT=20/minute
DEFAULT_ADMIN_EMAIL=admin@leadintel.local
DEFAULT_ADMIN_PASSWORD=Admin@123456
